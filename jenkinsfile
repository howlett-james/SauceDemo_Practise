pipeline {
    agent any

    tools {
        jdk 'JDK21'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/howlett-james/SauceDemo_Practise.git'
            }
        }

        stage('Build & Test') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'chmod +x gradlew'
                        sh './gradlew clean test'
                    } else {
                        bat 'gradlew.bat clean test'
                    }
                }
            }
        }
    }

    post {
        always {
            junit '**/test-results/**/*.xml'
        }
    }
}