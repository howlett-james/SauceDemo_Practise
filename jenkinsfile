pipeline {
    agent any

    tools {
        jdk 'JDK'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/howlett-james/SauceDemo_Practise.git'
            }
        }

        stage('Grant Permission') {
            steps {
                sh 'chmod +x gradlew'
            }
        }

        stage('Build & Test') {
            steps {
                sh './gradlew clean test'
            }
        }
    }

    post {
        always {
            junit '**/test-results/**/*.xml'
        }
    }
}